# Copied to .env by `make setup`. Host-side addresses for the docker compose services.
# Containers get their own (docker-network) addresses from compose.yaml.

# --- host ports (change if something on your machine already uses them) ---
POSTGRES_PORT=15432
REDIS_PORT=16379
MLFLOW_PORT=5000
AIRFLOW_PORT=8080

# --- how YOUR code (on the host) reaches the services ---
MLFLOW_TRACKING_URI=http://localhost:5000
REDIS_CONNECTION_STRING=localhost:16379
FEAST_REGISTRY_URL=postgresql+psycopg://lab:fraudlab@localhost:15432/feast
SERVING_URL=http://localhost:8000

# --- misc ---
FEAST_USAGE=False
MLFLOW_DISABLE_AGENT_HINT=1
# Set by `make setup`:
#   AIRFLOW_UID - files Airflow writes into ./data are owned by you, not root
#   LAB_ROOT    - absolute path of this repo; containers mount it at the same path
AIRFLOW_UID=50000
LAB_ROOT=
